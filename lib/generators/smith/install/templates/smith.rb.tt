# frozen_string_literal: true

Smith.configure do |config|
  config.logger = Rails.logger

  # Host durability verification / persistence adapter options:
  # config.persistence_adapter = :rails_cache
  # config.persistence_options = { namespace: "smith" }
  #
  # config.persistence_adapter = :solid_cache
  # config.persistence_options = { namespace: "smith" }
  #
  # config.persistence_adapter = :redis
  # config.persistence_options = {
  #   redis: Redis.new(url: ENV.fetch("REDIS_URL")),
  #   namespace: "smith"
  # }
  #
  # config.persistence_adapter = :active_record
  # config.persistence_options = {
  #   model: WorkflowState,
  #   key_column: :key,
  #   payload_column: :payload
  # }
  #
  # Custom adapters are also supported if they implement:
  #   store(key, payload)
  #   fetch(key)
  #   delete(key)

  # Artifact storage for large outputs and the documents steps attach. Like
  # workflow state it must outlive the process for runs that wait, retry or
  # resume elsewhere; with none set, storing or reading an artifact raises
  # Smith::ArtifactStoreMissing (smith:doctor warns).
  #
  # config.artifact_store = :s3   # AWS S3, or Cloudflare R2 (needs the aws-sdk-s3 gem)
  # config.artifact_options = {
  #   bucket: "smith-artifacts",
  #   endpoint: "https://<account>.r2.cloudflarestorage.com", region: "auto",
  #   access_key_id: ENV["R2_ACCESS_KEY_ID"], secret_access_key: ENV["R2_SECRET_ACCESS_KEY"]
  # }
  #
  # config.artifact_store = :active_record   # a table: see the PERSISTENCE guide, Artifacts
  # config.artifact_options = { model: "SmithArtifact" }
  #
  # config.artifact_store = :memory   # one process only, e.g. in tests

  # Trace adapter (Smith::Trace::Memory, Smith::Trace::Logger, Smith::Trace::OpenTelemetry)
  config.trace_adapter = Smith::Trace::Logger

  # Best-known model-call cost tracking (optional)
  # config.pricing = Smith::Pricing.validate_catalog!(
  #   %w[openai gpt-4.1-nano] => {
  #     input_cost_per_token: 0.0000001,
  #     output_cost_per_token: 0.0000004,
  #     cache_read_cost_per_token: 0.000000025 # optional; 0 when absent
  #   }
  # )
end
