# frozen_string_literal: true

# Workflow runs' stored state, for Smith's :active_record persistence
# adapter: a key the database keeps unique (child runs' keys are 64
# characters), the state as JSON text, and the lock_version Smith's writes
# compare. The payload's limit makes MySQL choose a text type that holds it.
class Create<%= table_name.camelize %> < ActiveRecord::Migration[<%= ActiveRecord::Migration.current_version %>]
  def change
    create_table :<%= table_name %> do |t|
      t.string :key, null: false, index: { unique: true }
      t.text :payload, null: false, limit: <%= literal(payload_limit) %>
      t.integer :lock_version, null: false, default: 0
      t.timestamps
    end
<%- if check_bytes -%>

    # Smith refuses a state past persistence_max_bytes (<%= literal(max_state_bytes) %>) before
    # writing it; this bounds the stored bytes, with room for an encrypted column.
    add_check_constraint :<%= table_name %>, "#{payload_bytes} <= <%= check_bytes %>",
                         name: "<%= table_name %>_payload_size"
<%- end -%>
  end
<%- if check_bytes -%>

  private

  def payload_bytes
    connection.adapter_name.match?(/sqlite/i) ? "length(CAST(payload AS BLOB))" : "octet_length(payload)"
  end
<%- end -%>
end
