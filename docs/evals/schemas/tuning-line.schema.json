{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smith:evals:1:tuning-line",
  "title": "Smith tuning run line (format version 0, provisional)",
  "description": "One line of a tuning run's lines.jsonl: a reflection call, written the moment it returns, or an iteration, written when it ends. A line is known by its type and iteration; the same line again changes nothing.",
  "oneOf": [
    {
      "$ref": "#/$defs/reflection"
    },
    {
      "$ref": "#/$defs/iteration"
    }
  ],
  "$defs": {
    "reflection": {
      "type": "object",
      "required": [
        "format",
        "format_version",
        "tuning_run_id",
        "type",
        "iteration",
        "trial_id",
        "step",
        "output",
        "failure",
        "stop"
      ],
      "properties": {
        "format": {
          "const": "smith.tuning.line"
        },
        "format_version": {
          "description": "Version 0: provisional, for the pilot cut of slice 5a; frozen as 1 when slice 5a ends.",
          "const": 0
        },
        "tuning_run_id": {
          "$ref": "urn:smith:evals:1:common#/$defs/tuning_run_id"
        },
        "type": {
          "const": "reflection"
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "trial_id": {
          "$ref": "urn:smith:evals:1:common#/$defs/trial_id"
        },
        "step": {
          "description": "The reflection call's step record, messages whole; null when no call started.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:smith:evals:1:trial#/$defs/step"
            }
          ]
        },
        "output": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "idea",
                "instruction"
              ],
              "properties": {
                "idea": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "instruction": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "failure": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "error_class",
                "message"
              ],
              "properties": {
                "kind": {
                  "$ref": "urn:smith:evals:1:common#/$defs/code"
                },
                "error_class": {
                  "type": "string",
                  "maxLength": 512
                },
                "message": {
                  "type": "string",
                  "maxLength": 1024
                }
              }
            }
          ]
        },
        "stop": {
          "description": "Why the call ends the tuning run: cap_reached or cancelled when the cap or a cancel refused it; null when it does not (a model's failure ends only its iteration). Open vocabulary.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:smith:evals:1:common#/$defs/code"
            }
          ]
        }
      }
    },
    "iteration": {
      "type": "object",
      "required": [
        "format",
        "format_version",
        "tuning_run_id",
        "type",
        "iteration",
        "parent",
        "component",
        "minibatch",
        "ended_as",
        "child",
        "validation",
        "totals",
        "rng",
        "cursor"
      ],
      "properties": {
        "format": {
          "const": "smith.tuning.line"
        },
        "format_version": {
          "description": "Version 0: provisional, for the pilot cut of slice 5a; frozen as 1 when slice 5a ends.",
          "const": 0
        },
        "tuning_run_id": {
          "$ref": "urn:smith:evals:1:common#/$defs/tuning_run_id"
        },
        "type": {
          "const": "iteration"
        },
        "iteration": {
          "description": "0 is the seed's validation pass.",
          "type": "integer",
          "minimum": 0
        },
        "parent": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "candidate_id",
                "index"
              ],
              "properties": {
                "candidate_id": {
                  "type": "string",
                  "pattern": "^cd_[0-9a-f]{32}$"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "component": {
          "description": "The component the parent's child rewrites; null for the seed.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "minibatch": {
          "description": "The parent's run on the iteration's training samples.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "sample_ids",
                "eval_run_id",
                "scores",
                "mean"
              ],
              "properties": {
                "sample_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "urn:smith:evals:1:common#/$defs/sample_id"
                  }
                },
                "eval_run_id": {
                  "$ref": "urn:smith:evals:1:common#/$defs/eval_run_id"
                },
                "scores": {
                  "description": "Each sample's score, 0 to 1 (a failed or errored trial scores 0), by sample id.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "mean": {
                  "description": "The mean of the scores; null when no sample ran.",
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          ]
        },
        "ended_as": {
          "description": "accepted (the seed, or a child that joined the pool), rejected, perfect_minibatch, proposal_invalid, reflection_failed or incomplete. Open vocabulary.",
          "$ref": "urn:smith:evals:1:common#/$defs/code"
        },
        "child": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "candidate_id",
                "index",
                "component",
                "version",
                "text",
                "idea",
                "minibatch"
              ],
              "properties": {
                "candidate_id": {
                  "type": "string",
                  "pattern": "^cd_[0-9a-f]{32}$"
                },
                "index": {
                  "description": "Its index in the pool; null when it did not join.",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "component": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "version": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "urn:smith:evals:1:common#/$defs/content_hash"
                    }
                  ]
                },
                "text": {
                  "description": "The text it changed; null for the seed, whose texts are the subject's.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "idea": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "minibatch": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "eval_run_id",
                        "scores",
                        "mean"
                      ],
                      "properties": {
                        "eval_run_id": {
                          "$ref": "urn:smith:evals:1:common#/$defs/eval_run_id"
                        },
                        "scores": {
                          "description": "Each sample's score, 0 to 1 (a failed or errored trial scores 0), by sample id.",
                          "type": "object",
                          "additionalProperties": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },
                        "mean": {
                          "description": "The mean of the scores; null when no sample ran.",
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "validation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "eval_run_id",
                "scores",
                "mean",
                "n"
              ],
              "properties": {
                "eval_run_id": {
                  "$ref": "urn:smith:evals:1:common#/$defs/eval_run_id"
                },
                "scores": {
                  "description": "Each sample's score, 0 to 1 (a failed or errored trial scores 0), by sample id.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "mean": {
                  "description": "The mean of the scores; null when no sample ran.",
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "n": {
                  "description": "How many samples have a score.",
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "totals": {
          "description": "The run's totals once the iteration ended.",
          "type": "object",
          "required": [
            "metric_calls",
            "provider_calls",
            "cost_nanos",
            "cost_complete",
            "reflection_calls"
          ],
          "properties": {
            "metric_calls": {
              "$ref": "urn:smith:evals:1:common#/$defs/count"
            },
            "provider_calls": {
              "$ref": "urn:smith:evals:1:common#/$defs/count"
            },
            "cost_nanos": {
              "$ref": "urn:smith:evals:1:common#/$defs/cost_nanos"
            },
            "cost_complete": {
              "type": "boolean"
            },
            "reflection_calls": {
              "$ref": "urn:smith:evals:1:common#/$defs/count"
            }
          }
        },
        "rng": {
          "description": "The run's SplitMix64 state once the iteration ended, 16 hex digits.",
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "cursor": {
          "description": "Where the minibatches stand: the epoch and how many of its ids are drawn.",
          "type": "object",
          "required": [
            "epoch",
            "position"
          ],
          "properties": {
            "epoch": {
              "$ref": "urn:smith:evals:1:common#/$defs/count"
            },
            "position": {
              "$ref": "urn:smith:evals:1:common#/$defs/count"
            }
          }
        }
      }
    }
  }
}
