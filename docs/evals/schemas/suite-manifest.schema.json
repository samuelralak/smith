                  "binary",
                  "continuous"
                ]
              },
              "reduce": {
                "type": "string",
                "pattern": "^(majority|any|all|mean|pass_at_[1-9][0-9]?|pass_all_[1-9][0-9]?)$"
              },
              "also": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(majority|any|all|mean|pass_at_[1-9][0-9]?|pass_all_[1-9][0-9]?)$"
                },
                "uniqueItems": true
              },
              "on_subject_failure": {
                "description": "fail: a failed subject counts as a fail without the scorer; score: the scorer runs and reads the failure.",
                "enum": [
                  "fail",
                  "score"
                ]
              },
              "judge": {
                "type": "object"
              }
            }
          }
        ]
      }
    },
    "statistics": {
      "type": "object",
      "required": [
        "level",
        "bootstrap_resamples",
        "small_sample_threshold"
      ],
      "properties": {
        "level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "bootstrap_resamples": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000
        },
        "small_sample_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "recording": {
      "description": "Whether step records keep message content. Not part of the measure.",
      "type": "object",
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "boolean"
        }
      }
    },
    "gates": {
      "description": "Fixed targets (at_least) in slice 1b, judged on the headline estimate's point; baseline and statistical gates in slice 2.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "scorer"
        ],
        "properties": {
          "id": {
            "$ref": "urn:smith:evals:1:common#/$defs/code"
          },
          "kind": {
            "$ref": "urn:smith:evals:1:common#/$defs/code"
          },
          "scorer": {
            "$ref": "urn:smith:evals:1:common#/$defs/scorer_name"
          },
          "reducer": {
            "type": "string"
          },
          "target": {
            "type": "number"
          },
          "margin": {
            "type": "number"
          },
          "baseline_eval_run_id": {
            "$ref": "urn:smith:evals:1:common#/$defs/eval_run_id"
          }
        }
      }
    },
    "budget": {
      "description": "DRAFT (slice 1b): the eval run's cap.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "max_cost_nanos": {
          "$ref": "urn:smith:evals:1:common#/$defs/cost_nanos"
        }
      }
    },
    "labels": {
      "description": "DRAFT (slice 2): which labels count.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "accept": {
          "enum": [
            "any",
            "human_only"
          ]
        }
      }
    },
    "judges": {
      "description": "DRAFT (slice 2).",
      "type": "array"
    }
  }
}
