                ]
              },
              "params": {
                "type": "object",
                "required": [
                  "expected",
                  "match",
                  "max_calls"
                ],
                "properties": {
                  "expected": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
                    }
                  },
                  "match": {
                    "description": "exact: these calls, in this order, and no others; in_order: these calls appear in this order, others may come between; any_order: each appears, as many times as listed.",
                    "enum": [
                      "exact",
                      "in_order",
                      "any_order"
                    ]
                  },
                  "max_calls": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            }
          },
          {
            "description": "DRAFT (slice 2): a model judge.",
            "type": "object",
            "required": [
              "name",
              "kind",
              "version"
            ],
            "properties": {
              "name": {
                "$ref": "urn:smith:evals:1:common#/$defs/scorer_name"
              },
              "kind": {
                "const": "judge"
              },
              "version": {
                "type": "integer",
