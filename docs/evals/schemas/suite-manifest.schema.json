                    ]
                  },
                  "max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "inclusive": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          {
            "description": "The right tools were called.",
            "type": "object",
            "required": [
              "name",
              "kind",
              "check",
              "version",
              "scale",
              "reduce",
              "also",
              "on_subject_failure",
              "params"
            ],
            "properties": {
              "name": {
                "$ref": "urn:smith:evals:1:common#/$defs/scorer_name"
              },
              "kind": {
                "const": "check"
              },
              "check": {
                "const": "tools_called"
              },
              "version": {
                "description": "The check's revision in Smith's vocabulary; 1 for format 1.",
                "type": "integer",
                "minimum": 1
              },
              "scale": {
                "const": "binary"
              },
              "reduce": {
                "type": "string",
                "pattern": "^(majority|any|all|mean|pass_at_[1-9][0-9]?|pass_all_[1-9][0-9]?)$"
              },
              "also": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(majority|any|all|mean|pass_at_[1-9][0-9]?|pass_all_[1-9][0-9]?)$"
                },
                "uniqueItems": true
              },
              "on_subject_failure": {
                "description": "fail: a failed subject counts as a fail without the scorer; score: the scorer runs and reads the failure.",
                "enum": [
                  "fail",
